<!-- Contains required properties for osu!framework projects. -->
<Project>
  <PropertyGroup>
    <ApplicationManifest>$(MSBuildThisFileDirectory)app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!--
    Suppressed dependency advisories. Both packages are pinned by osu.Framework/osu.Game and cannot be
    updated without breaking them upstream:
      * SixLabors.ImageSharp 3.1.11 - 3.2.0+ adds a build-time license check that fails Release builds
        unless a Six Labors license is supplied. All known advisories are in image codecs that this
        project only feeds its own bundled assets, never untrusted files.
      * AutoMapper 13.0.1 - 15.0.0 changed the MapperConfiguration constructor to require an
        ILoggerFactory and moved off MIT. osu.Game is compiled against 13.x, so a newer version throws
        MissingMethodException at runtime. osu! suppresses this advisory upstream for the same reason.
    Remove an entry once a compatible (or licensed) update becomes available.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
</Project>
